# Copy this file to .env. Never commit a real .env.
NODE_ENV=development

# Backend
PORT=4000
DB_PROVIDER=sqlite
# SQLite URL is relative to backend/prisma/schema.sqlite.prisma.
DATABASE_URL=file:../data/dev.db
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisLocalPassword123!
AUTH_COOKIE_NAME=wa_admin
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:3000
AUTH_DIR=./data/auth
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn

# Frontend (baked in at build time for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
